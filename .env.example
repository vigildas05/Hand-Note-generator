# Copy this file to .env and change values as needed.
# Only variables starting with VITE_ are available to the app.
# NOTE: everything here is baked into the public website at build time,
# so NEVER put passwords, API keys or other secrets in this file.

# Name shown in the header and browser tab
VITE_APP_NAME=Handwriter

# Largest upload allowed, in megabytes
VITE_MAX_FILE_MB=25

# Only the first N pages of a PDF are converted (protects slow devices)
VITE_MAX_PAGES=30
